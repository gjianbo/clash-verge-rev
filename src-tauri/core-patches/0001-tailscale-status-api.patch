+
+// Status reports the current tsnet state, including this node and all peers.
+// It is used by the client to render a Tailscale status page.
+func (t *Tailscale) Status(ctx context.Context) (*ipnstate.Status, error) {
+	if err := t.ensureStarted(ctx); err != nil {
+		return nil, err
+	}
+
+	lc, err := t.server.LocalClient()
+	if err != nil {
+		return nil, err
+	}
+
+	return lc.Status(ctx)
+}
+
+// Ping sends a disco ping to the given tailnet address, reporting latency and
+// the endpoint actually used (direct vs relay).
+func (t *Tailscale) Ping(ctx context.Context, ip netip.Addr) (*ipnstate.PingResult, error) {
+	if err := t.ensureStarted(ctx); err != nil {
+		return nil, err
+	}
+
+	lc, err := t.server.LocalClient()
+	if err != nil {
+		return nil, err
+	}
+
+	return lc.Ping(ctx, ip, tailcfg.PingDisco)
+}
