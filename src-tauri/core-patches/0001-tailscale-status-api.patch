diff --git a/hub/route/tailscale.go b/hub/route/tailscale.go
new file mode 100644
index 0000000..73b330f
--- /dev/null
+++ b/hub/route/tailscale.go
@@ -0,0 +1,193 @@
+//go:build with_gvisor && !no_tailscale
+
+package route
+
+import (
+	"context"
+	"net/netip"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter/outbound"
+
+	"github.com/metacubex/chi"
+	"github.com/metacubex/chi/render"
+	"github.com/metacubex/http"
+	"github.com/metacubex/tailscale/ipn/ipnstate"
+)
+
+func tailscaleRouter() http.Handler {
+	r := chi.NewRouter()
+	r.Get("/status", getTailscaleStatus)
+	r.Post("/ping", pingTailscalePeer)
+	return r
+}
+
+type tailscalePeerView struct {
+	Hostname       string   `json:"hostname"`
+	DNSName        string   `json:"dnsName,omitempty"`
+	OS             string   `json:"os,omitempty"`
+	IPs            []string `json:"ips"`
+	Online         bool     `json:"online"`
+	Active         bool     `json:"active"`
+	ExitNode       bool     `json:"exitNode"`
+	ExitNodeOption bool     `json:"exitNodeOption"`
+	Relay          string   `json:"relay,omitempty"`
+	Endpoint       string   `json:"endpoint,omitempty"`
+	LastSeen       string   `json:"lastSeen,omitempty"`
+}
+
+type tailscaleStatusView struct {
+	Available       bool                `json:"available"`
+	BackendState    string              `json:"backendState"`
+	Version         string              `json:"version"`
+	Hostname        string              `json:"hostname"`
+	DNSName         string              `json:"dnsName,omitempty"`
+	Tailnet         string              `json:"tailnet,omitempty"`
+	MagicDNSSuffix  string              `json:"magicDnsSuffix,omitempty"`
+	MagicDNSEnabled bool                `json:"magicDnsEnabled"`
+	AuthURL         string              `json:"authUrl,omitempty"`
+	IPs             []string            `json:"ips"`
+	OS              string              `json:"os,omitempty"`
+	Health          []string            `json:"health"`
+	Self            *tailscalePeerView  `json:"self,omitempty"`
+	Peers           []tailscalePeerView `json:"peers"`
+}
+
+type tailscalePingRequest struct {
+	IP string `json:"ip"`
+}
+
+type tailscalePingView struct {
+	IP             string  `json:"ip"`
+	NodeIP         string  `json:"nodeIp,omitempty"`
+	NodeName       string  `json:"nodeName,omitempty"`
+	LatencySeconds float64 `json:"latencySeconds"`
+	Endpoint       string  `json:"endpoint,omitempty"`
+	Relay          string  `json:"relay,omitempty"`
+	Error          string  `json:"error,omitempty"`
+}
+
+func stringifyIPs(ips []netip.Addr) []string {
+	result := make([]string, 0, len(ips))
+	for _, ip := range ips {
+		result = append(result, ip.String())
+	}
+	return result
+}
+
+func tailscalePeerFromStatus(peer *ipnstate.PeerStatus) tailscalePeerView {
+	view := tailscalePeerView{
+		Hostname:       peer.HostName,
+		DNSName:        strings.TrimSuffix(peer.DNSName, "."),
+		OS:             peer.OS,
+		IPs:            stringifyIPs(peer.TailscaleIPs),
+		Online:         peer.Online,
+		Active:         peer.Active,
+		ExitNode:       peer.ExitNode,
+		ExitNodeOption: peer.ExitNodeOption,
+		Relay:          peer.Relay,
+		Endpoint:       peer.CurAddr,
+	}
+	if !peer.LastSeen.IsZero() {
+		view.LastSeen = peer.LastSeen.UTC().Format(time.RFC3339)
+	}
+	return view
+}
+
+func getTailscaleStatus(w http.ResponseWriter, r *http.Request) {
+	tailscale := outbound.LookupTailscale()
+	if tailscale == nil {
+		render.Status(r, http.StatusNotFound)
+		render.JSON(w, r, newError("Tailscale outbound is not loaded"))
+		return
+	}
+
+	ctx, cancel := context.WithTimeout(r.Context(), 20*time.Second)
+	defer cancel()
+	status, err := tailscale.Status(ctx)
+	if err != nil {
+		render.Status(r, http.StatusInternalServerError)
+		render.JSON(w, r, newError(err.Error()))
+		return
+	}
+
+	health := status.Health
+	if health == nil {
+		health = []string{}
+	}
+	view := tailscaleStatusView{
+		Available:    true,
+		BackendState: status.BackendState,
+		Version:      status.Version,
+		AuthURL:      status.AuthURL,
+		IPs:          stringifyIPs(status.TailscaleIPs),
+		Health:       health,
+		Peers:        make([]tailscalePeerView, 0, len(status.Peer)),
+	}
+	if status.CurrentTailnet != nil {
+		view.Tailnet = status.CurrentTailnet.Name
+		view.MagicDNSSuffix = status.CurrentTailnet.MagicDNSSuffix
+		view.MagicDNSEnabled = status.CurrentTailnet.MagicDNSEnabled
+	}
+	if status.MagicDNSSuffix != "" && view.MagicDNSSuffix == "" {
+		view.MagicDNSSuffix = status.MagicDNSSuffix
+	}
+	if status.Self != nil {
+		self := tailscalePeerFromStatus(status.Self)
+		view.Hostname = status.Self.HostName
+		view.DNSName = self.DNSName
+		view.OS = status.Self.OS
+		view.Self = &self
+	}
+	for _, peer := range status.Peer {
+		view.Peers = append(view.Peers, tailscalePeerFromStatus(peer))
+	}
+	sort.Slice(view.Peers, func(i, j int) bool {
+		return view.Peers[i].Hostname < view.Peers[j].Hostname
+	})
+
+	render.JSON(w, r, view)
+}
+
+func pingTailscalePeer(w http.ResponseWriter, r *http.Request) {
+	tailscale := outbound.LookupTailscale()
+	if tailscale == nil {
+		render.Status(r, http.StatusNotFound)
+		render.JSON(w, r, newError("Tailscale outbound is not loaded"))
+		return
+	}
+
+	var request tailscalePingRequest
+	if err := render.DecodeJSON(r.Body, &request); err != nil {
+		render.Status(r, http.StatusBadRequest)
+		render.JSON(w, r, ErrBadRequest)
+		return
+	}
+	ip, err := netip.ParseAddr(request.IP)
+	if err != nil {
+		render.Status(r, http.StatusBadRequest)
+		render.JSON(w, r, newError("Invalid Tailscale IP: "+request.IP))
+		return
+	}
+
+	ctx, cancel := context.WithTimeout(r.Context(), 20*time.Second)
+	defer cancel()
+	result, err := tailscale.Ping(ctx, ip)
+	if err != nil {
+		render.Status(r, http.StatusInternalServerError)
+		render.JSON(w, r, newError(err.Error()))
+		return
+	}
+
+	render.JSON(w, r, tailscalePingView{
+		IP:             result.IP,
+		NodeIP:         result.NodeIP,
+		NodeName:       result.NodeName,
+		LatencySeconds: result.LatencySeconds,
+		Endpoint:       result.Endpoint,
+		Relay:          result.DERPRegionCode,
+		Error:          result.Err,
+	})
+}
diff --git a/hub/route/tailscale_stub.go b/hub/route/tailscale_stub.go
new file mode 100644
index 0000000..089e4de
--- /dev/null
+++ b/hub/route/tailscale_stub.go
@@ -0,0 +1,20 @@
+//go:build !with_gvisor || no_tailscale
+
+package route
+
+import (
+	"github.com/metacubex/chi"
+	"github.com/metacubex/chi/render"
+	"github.com/metacubex/http"
+)
+
+func tailscaleRouter() http.Handler {
+	r := chi.NewRouter()
+	unavailable := func(w http.ResponseWriter, r *http.Request) {
+		render.Status(r, http.StatusNotImplemented)
+		render.JSON(w, r, newError("Tailscale support is not compiled into this core"))
+	}
+	r.Get("/status", unavailable)
+	r.Post("/ping", unavailable)
+	return r
+}
